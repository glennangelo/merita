# Security and caching rules, applied by Cloudflare to the static files.
#
# Strict-Transport-Security: once a browser has seen this it refuses to load
# the site over plain http, so a mistyped or forwarded link cannot be read on a
# shared wifi. Two years, and every subdomain of whatever address it ends on.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data: blob:; style-src 'self'; script-src 'self'; font-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'
  Strict-Transport-Security: max-age=63072000; includeSubDomains

# Revalidated on every visit rather than held for an hour. These filenames
# never change, so a cached copy could not otherwise be replaced, and an edit
# would take up to an hour to reach anyone who had been here recently — the
# page would load new markup and run the old script. Revalidating costs a
# "not modified" reply, which is a few bytes.
/assets/*
  Cache-Control: no-cache

# The typefaces never change, so they only ever download once. These live
# outside /assets so this rule does not collide with the one above —
# Cloudflare merges the values of two matching rules rather than letting the
# more specific one win, which would produce a malformed Cache-Control.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Names and words that belong to other people. Search engines are asked in, so
# that they read the "noindex" and drop the page — a robots.txt block would keep
# them out and leave the address itself free to be listed.
/memories
  X-Robots-Tag: noindex, nofollow

/memories.html
  X-Robots-Tag: noindex, nofollow

# Cloudflare serves admin.html at /admin, so match both spellings. This address
# is deliberately not named in robots.txt, which is a public file — listing it
# there would tell every passing scanner exactly where to knock.
/admin
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

/admin.html
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

/api/*
  Cache-Control: no-store
